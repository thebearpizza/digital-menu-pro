{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--executablePath=/opt/pw-browsers/chromium",
        "--headless",
        "--isolated",
        "--viewport=390x844",
        "--chromeArg=--no-sandbox"
      ]
    }
  }
}
